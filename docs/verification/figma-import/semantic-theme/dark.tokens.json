{
  "text": {
    "default": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.9686274509803922, 0.9686274509803922, 0.9725490196078431], "alpha": 1, "hex": "#F7F7F8" },
      "$extensions": {
        "com.figma.scopes": ["ALL_SCOPES"],
        "com.figma.aliasData": { "targetVariableName": "gray/100", "targetVariableSetName": "primitives" }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "{text.default}",
      "$extensions": { "com.figma.scopes": ["ALL_SCOPES"] }
    }
  },
  "$extensions": { "com.figma.modeName": "dark" }
}
